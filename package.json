{
  "name": "@_bashell/slash",
  "version": "0.0.0",
  "description": "htm + hyper + reactive signals (no VDOM) — tiny, fast, DX-first",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bashell-rrocha/slash.git"
  },
  "homepage": "https://github.com/bashell-rrocha/slash#readme",
  "bugs": {
    "url": "https://github.com/bashell-rrocha/slash/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "bun": "./src/core.ts",
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs",
      "default": "./dist/core.mjs"
    },
    "./router": {
      "bun": "./src/router/index.ts",
      "types": "./dist/types/router/index.d.ts",
      "import": "./dist/router.mjs",
      "require": "./dist/router.cjs",
      "default": "./dist/router.mjs"
    },
    "./ssr": {
      "bun": "./src/ssr.ts",
      "types": "./dist/types/ssr.d.ts",
      "import": "./dist/ssr.mjs",
      "require": "./dist/ssr.cjs",
      "default": "./dist/ssr.mjs"
    },
    "./forms": {
      "bun": "./src/forms/index.ts",
      "types": "./dist/types/forms/index.d.ts",
      "import": "./dist/forms.mjs",
      "require": "./dist/forms.cjs",
      "default": "./dist/forms.mjs"
    }
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build:types": "tsc -p ./tsconfig.json",
    "build:esm": "FORMAT=esm NODE_ENV=production bun run scripts/build.ts",
    "build:cjs": "FORMAT=cjs NODE_ENV=production bun run scripts/build.ts",
    "build:compress": "bun run scripts/compress.ts",
    "build": "bun run clean && bun run build:esm && bun run build:cjs && bun run build:types && bun run build:compress",
    "dev:bundle": "FORMAT=esm NODE_ENV=development bun run scripts/build.ts --watch",
    "dev:types": "tsc -w -p ./tsconfig.json --preserveWatchOutput",
    "dev": "concurrently --kill-others --names \"types,bundle\" \"bun run dev:types\" \"bun run dev:bundle\"",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:bundle": "bun test scripts/bundle-size.test.ts"
  },
  "dependencies": {
    "htm": "^3.1.1"
  },
  "peerDependencies": {
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@happy-dom/global-registrator": "20.3.3",
    "@types/bun": "latest",
    "@types/node": "^24.5.0",
    "bun-types": "^1.3.3",
    "concurrently": "^9.1.2",
    "happy-dom": "20.3.3",
    "typescript": "^5.6.2"
  }
}
